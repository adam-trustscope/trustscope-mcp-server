{
  "name": "trustscope",
  "version": "1.0.0",
  "description": "AI governance for agents — scan, watch, protect, prove",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "trustscope": "./dist/index.js",
    "trustscope-mcp": "./dist/mcp-entry.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp-entry.mjs",
      "require": "./dist/mcp-entry.js",
      "types": "./dist/mcp-entry.d.ts"
    },
    "./evidence": {
      "import": "./dist/evidence/index.mjs",
      "require": "./dist/evidence/index.js",
      "types": "./dist/evidence/index.d.ts"
    },
    "./detection": {
      "import": "./dist/detection/index.mjs",
      "require": "./dist/detection/index.js",
      "types": "./dist/detection/index.d.ts"
    },
    "./policy": {
      "import": "./dist/policy/index.mjs",
      "require": "./dist/policy/index.js",
      "types": "./dist/policy/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "start:mcp": "node dist/mcp-entry.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "trustscope",
    "ai",
    "agents",
    "mcp",
    "governance",
    "security",
    "compliance",
    "model-context-protocol",
    "llm",
    "audit"
  ],
  "author": "TrustScope",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trustscope/trustscope.git"
  },
  "homepage": "https://trustscope.ai",
  "bugs": {
    "url": "https://github.com/trustscope/trustscope/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.0.1",
    "axios": "^1.6.0",
    "axios-retry": "^4.0.0",
    "better-sqlite3": "^11.0.0",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "express": "^4.18.2",
    "glob": "^10.3.0",
    "http-proxy-middleware": "^2.0.6",
    "inquirer": "^9.2.12",
    "nanoid": "^5.0.0",
    "octokit": "^3.1.0",
    "open": "^10.0.0",
    "ora": "^8.0.0",
    "simple-git": "^3.22.0",
    "yaml": "^2.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^4.17.21",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.0.18",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
